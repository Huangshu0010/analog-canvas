{
  "schemaVersion": 1,
  "ignoredPaths": [
    ".pnpm-store/**",
    ".worktrees/**",
    "node_modules/**",
    "output/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "pathGroups": {
    "documentation": ["**/*.md", "docs/**"],
    "source": ["apps/**", "packages/**", "worker/**", "scripts/**"],
    "editorInteraction": [
      "apps/editor/src/app/**",
      "apps/editor/src/canvas/**",
      "apps/editor/src/commands/**",
      "apps/editor/src/interaction/**",
      "apps/editor/src/presentation/**",
      "apps/editor/src/snap/**",
      "apps/editor/src/features/clipboard/**",
      "apps/editor/src/features/drafting/**",
      "apps/editor/src/features/instance-display/**",
      "apps/editor/src/features/netlist-export/**",
      "apps/editor/src/features/properties/**",
      "apps/editor/src/features/search/**",
      "apps/editor/src/features/selection/**",
      "apps/editor/src/features/text-editing/**",
      "apps/editor/src/features/wiring/**"
    ],
    "componentInsert": [
      "apps/editor/src/features/component-insert/**",
      "apps/editor/e2e/component-insert.spec.ts"
    ],
    "hierarchy": [
      "apps/editor/src/features/hierarchy/**",
      "apps/editor/e2e/hierarchy.spec.ts",
      "packages/model/**",
      "packages/project-protocol/**",
      "packages/edit-engine/**",
      "packages/symbols/**",
      "packages/render-svg/**"
    ],
    "projectPersistence": [
      "apps/editor/src/document/**",
      "apps/editor/e2e/project-file.spec.ts",
      "packages/model/**",
      "packages/project-protocol/**"
    ],
    "gallery": [
      "worker/auth.ts",
      "worker/auth.test.ts",
      "worker/gallery.ts",
      "worker/gallery.test.ts",
      "apps/editor/src/components/account.tsx",
      "apps/editor/src/components/account.test.tsx",
      "apps/editor/src/components/gallery-chrome.tsx",
      "apps/editor/src/components/gallery-feed.tsx",
      "apps/editor/src/components/gallery-feed.test.tsx",
      "apps/editor/src/components/masonry.tsx",
      "apps/editor/src/components/masonry.test.ts",
      "apps/editor/src/components/moderation.tsx",
      "apps/editor/src/components/my-submissions.tsx",
      "apps/editor/src/components/version-history-dialog.tsx",
      "apps/editor/src/features/editor-shell/examples-panel.tsx",
      "apps/editor/src/features/editor-shell/examples-panel.test.ts",
      "apps/editor/src/features/editor-shell/gallery-publish.ts",
      "apps/editor/src/features/editor-shell/gallery-publish.test.ts",
      "apps/editor/src/features/editor-shell/publish-gallery-dialog.tsx",
      "apps/editor/src/features/editor-shell/publish-gallery-dialog.test.tsx",
      "apps/editor/src/features/editor-shell/workspace-shelf.ts",
      "apps/editor/src/features/editor-shell/workspace-shelf.test.ts",
      "apps/editor/e2e/gallery.spec.ts"
    ],
    "agent": [
      "apps/editor/src/agent/**",
      "apps/editor/e2e/web-agent-session.spec.ts",
      "apps/mcp-server/**",
      "packages/agent-adapter/**",
      "packages/agent-client/**",
      "packages/agent-routing/**"
    ],
    "release": [
      "apps/local-host/**",
      "config/agent-mcp-distribution.json",
      "packages/exporters/**",
      "scripts/export-golden.mjs",
      "scripts/visual-golden.mjs",
      "scripts/package-*.mjs",
      "scripts/pwa-icons.mjs",
      "scripts/*release-smoke.mjs",
      "scripts/editor-production-smoke.mjs"
    ],
    "highRisk": [
      "packages/model/**",
      "packages/project-protocol/**",
      "packages/edit-engine/**",
      "packages/derived/**",
      "packages/devices/**",
      "packages/symbols/**",
      "packages/render-svg/**",
      "packages/spice/**",
      "packages/netlist/**",
      "packages/exporters/**",
      "worker/index.ts",
      "worker/index.test.ts",
      "worker/analytics.ts",
      "wrangler.jsonc"
    ],
    "gateContract": [
      ".github/workflows/**",
      "AGENTS.md",
      "package.json",
      "pnpm-lock.yaml",
      "config/validation-gates.json",
      "docs/testing/**",
      "scripts/gate-*.mjs",
      "scripts/check-test-impact.mjs",
      "scripts/ci-plan.mjs",
      "scripts/lib/test-impact*.mjs",
      "scripts/lib/ci-validation-plan*.mjs",
      "scripts/lib/validation-gates*.mjs"
    ]
  },
  "gates": [
    {
      "id": "documentation-links",
      "stage": "preflight",
      "when": "docs-only",
      "description": "Validate links for documentation-only changes.",
      "command": ["pnpm", "docs:check"]
    },
    {
      "id": "static-contracts",
      "stage": "preflight",
      "when": "non-doc",
      "description": "Formatting, generated metadata, documentation, and type contracts.",
      "command": ["pnpm", "ci:static"]
    },
    {
      "id": "test-impact",
      "stage": "preflight",
      "when": "non-doc",
      "description": "Require explicit test and gate impact declarations.",
      "command": ["pnpm", "test:impact", "--", "--base", "{base}"]
    },
    {
      "id": "workspace-unit",
      "stage": "affected",
      "groups": ["source"],
      "description": "Run the bounded-concurrency workspace unit and module contracts.",
      "command": ["pnpm", "test:local"]
    },
    {
      "id": "component-insert-browser",
      "stage": "affected",
      "groups": ["componentInsert"],
      "description": "Validate component catalog and placement workflows.",
      "command": [
        "pnpm",
        "test:e2e:local",
        "apps/editor/e2e/component-insert.spec.ts"
      ],
      "ci": { "e2eArgs": ["apps/editor/e2e/component-insert.spec.ts"] }
    },
    {
      "id": "hierarchy-browser",
      "stage": "affected",
      "groups": ["hierarchy"],
      "description": "Validate Cell hierarchy authoring and instance workflows.",
      "command": [
        "pnpm",
        "test:e2e:local",
        "apps/editor/e2e/hierarchy.spec.ts"
      ],
      "ci": { "e2eArgs": ["apps/editor/e2e/hierarchy.spec.ts"] }
    },
    {
      "id": "project-file-browser",
      "stage": "affected",
      "groups": ["projectPersistence"],
      "description": "Validate persisted Project compatibility and save/open workflows.",
      "command": [
        "pnpm",
        "test:e2e:local",
        "apps/editor/e2e/project-file.spec.ts"
      ],
      "ci": {
        "e2eArgs": [
          "apps/editor/e2e/project-file.spec.ts",
          "apps/editor/e2e/recovery-dialog.spec.ts",
          "apps/editor/e2e/recovery-hardening.spec.ts"
        ]
      }
    },
    {
      "id": "gallery-browser",
      "stage": "affected",
      "groups": ["gallery"],
      "description": "Validate Gallery, account, submission, moderation, and workspace workflows.",
      "command": ["pnpm", "test:e2e:local", "apps/editor/e2e/gallery.spec.ts"],
      "ci": { "e2eArgs": ["apps/editor/e2e/gallery.spec.ts"] }
    },
    {
      "id": "agent-browser",
      "stage": "affected",
      "groups": ["agent"],
      "description": "Validate the browser-authoritative Agent session workflow.",
      "command": [
        "pnpm",
        "test:e2e:local",
        "apps/editor/e2e/web-agent-session.spec.ts"
      ],
      "ci": { "e2eArgs": ["apps/editor/e2e/web-agent-session.spec.ts"] }
    },
    {
      "id": "editor-browser",
      "stage": "affected",
      "groups": ["editorInteraction"],
      "description": "Validate general canvas and editor interaction workflows.",
      "command": [
        "pnpm",
        "test:e2e:local",
        "apps/editor/e2e/manual-editor.spec.ts"
      ],
      "ci": {
        "e2eArgs": [
          "apps/editor/e2e/manual-editor.spec.ts",
          "apps/editor/e2e/drafting.spec.ts",
          "apps/editor/e2e/instance-table.spec.ts"
        ]
      }
    },
    {
      "id": "release-verification",
      "stage": "affected",
      "groups": ["release"],
      "description": "Build and validate release packaging, goldens, and smoke contracts.",
      "command": ["pnpm", "release:verify"]
    },
    {
      "id": "branch-verification",
      "stage": "affected",
      "groups": ["gateContract"],
      "description": "Conservatively verify a branch that changes gate policy or infrastructure.",
      "command": ["pnpm", "verify:branch"],
      "supersedes": ["workspace-unit"]
    },
    {
      "id": "full-delivery",
      "stage": "final",
      "groups": ["highRisk"],
      "description": "Canonical complete gate for shared-core and production-boundary changes.",
      "command": ["pnpm", "ci:check"]
    }
  ],
  "fullFallback": {
    "gateContractGroups": ["gateContract"],
    "preflightGate": "static-contracts",
    "affectedGate": "branch-verification",
    "finalGate": "full-delivery"
  }
}
