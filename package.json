{
  "name": "interactive-circuit-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "release:package": "pnpm build && node scripts/package-release.mjs",
    "performance:check": "pnpm build && node scripts/performance-baseline.mjs",
    "export:phase7": "pnpm build && node scripts/phase-7-export-golden.mjs",
    "export:phase7:check": "pnpm build && node scripts/phase-7-export-golden.mjs --check",
    "pwa:icons": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs",
    "pwa:icons:check": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs --check",
    "release:verify": "pnpm build && node scripts/performance-baseline.mjs && node scripts/phase-7-export-golden.mjs --check && node scripts/pwa-icons.mjs --check && node scripts/editor-production-smoke.mjs --check && node scripts/package-release.mjs && node scripts/release-smoke.mjs",
    "agent-api:artifacts": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs",
    "agent-api:artifacts:check": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs --check",
    "phase9:generalization": "pnpm build && node scripts/phase-9-generalization.mjs",
    "phase9:generalization:check": "pnpm build && node scripts/phase-9-generalization.mjs --check",
    "phase9:skill:check": "node scripts/phase-9-skill-evaluation.mjs --check",
    "phase9:external-eval:self-test": "pnpm build && node scripts/phase-9-external-quality-eval.mjs self-test",
    "phase9:heldout:check": "pnpm build && node scripts/phase-9-heldout-fixture.mjs --check",
    "phase9:heldout:chopper:check": "pnpm build && node scripts/phase-9-heldout-chopper-fixture.mjs --check",
    "phase9:heldout:ring:check": "pnpm build && node scripts/phase-9-heldout-differential-ring-fixture.mjs --check",
    "dev": "pnpm --filter @icm/editor dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,tsx,json}\" \"references/**/*.json\" \"scripts/**/*.mjs\" \"*.{json,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,tsx,json}\" \"references/**/*.json\" \"scripts/**/*.mjs\" \"*.{json,yaml}\"",
    "references:check": "node scripts/check-references.mjs",
    "symbols:review": "pnpm --filter @icm/symbols build && node tools/symbol-review/render-reviewed.mjs",
    "symbols:review:check": "pnpm --filter @icm/symbols build && node tools/symbol-review/render-reviewed.mjs --check",
    "symbols:razavi": "node scripts/generate-razavi-symbol-catalog.mjs",
    "symbols:razavi:check": "node scripts/generate-razavi-symbol-catalog.mjs --check",
    "symbols:razavi-mos": "node scripts/generate-razavi-mos-assets.mjs",
    "symbols:razavi-mos:check": "node scripts/generate-razavi-mos-assets.mjs --check",
    "symbols:razavi-peripherals": "node scripts/generate-razavi-peripheral-assets.mjs",
    "symbols:razavi-peripherals:check": "node scripts/generate-razavi-peripheral-assets.mjs --check",
    "symbols:visio-mos": "node scripts/generate-visio-mos-assets.mjs",
    "symbols:visio-mos:check": "node scripts/generate-visio-mos-assets.mjs --check",
    "symbols:visio-mos:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/vss-import/Export-VisioMosReferences.ps1",
    "symbols:visio-mos:reference:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/vss-import/Export-VisioMosReferences.ps1 -Check",
    "symbols:visio-core-analog:reference": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/vss-import/Export-VisioCoreAnalogReferences.ps1",
    "symbols:visio-core-analog:reference:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/vss-import/Export-VisioCoreAnalogReferences.ps1 -Check",
    "symbols:visio-core-analog": "node scripts/generate-visio-core-analog-assets.mjs",
    "symbols:visio-core-analog:check": "node scripts/generate-visio-core-analog-assets.mjs --check",
    "visual:phase5": "pnpm build && node scripts/phase-5-golden.mjs",
    "visual:phase5:check": "pnpm build && node scripts/phase-5-golden.mjs --check",
    "visual:current-arrow": "pnpm build && node scripts/route-attached-current-arrow-golden.mjs",
    "visual:current-arrow:check": "pnpm build && node scripts/route-attached-current-arrow-golden.mjs --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production-smoke": "pnpm --filter @icm/editor build && node scripts/editor-production-smoke.mjs",
    "test:production-smoke:check": "pnpm --filter @icm/editor build && node scripts/editor-production-smoke.mjs --check",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
